{
  "meta": {
    "project": "RecipeCraft",
    "version": "1.0.0",
    "description": "Complete design token system — colors, typography, spacing for all pages and components",
    "stack": "Vite + React + TypeScript + Tailwind CSS v3"
  },

  "brand": {
    "rust": {
      "DEFAULT": "#C8501A",
      "light":   "#E8724A",
      "lighter": "#F5A882",
      "dark":    "#A03D12",
      "darker":  "#7A2D0C",
      "usage":   "Primary CTA buttons, like button active, active nav tab border, required field marker, delete actions"
    },
    "forest": {
      "DEFAULT": "#2D4A3E",
      "light":   "#3D6B5C",
      "lighter": "#5C9480",
      "dark":    "#1E3229",
      "darker":  "#111E18",
      "usage":   "Navbar background, sidebar background, follow button, step numbers, section headings"
    },
    "gold": {
      "DEFAULT": "#D4A843",
      "light":   "#F0C868",
      "lighter": "#F7E0A0",
      "dark":    "#A87E28",
      "darker":  "#7B5A00",
      "usage":   "Logo accent dot, hero eyebrow badge, trending badge, medium difficulty badge, star ratings"
    },
    "cream": {
      "DEFAULT": "#FDF6EC",
      "dark":    "#F5EAD8",
      "darker":  "#EDD9BE",
      "usage":   "Page background, hero text on dark backgrounds, email template background"
    },
    "charcoal": {
      "DEFAULT": "#1C1C1C",
      "soft":    "#2C2C2C",
      "muted":   "#3D3D3D",
      "usage":   "Primary body text, headings on light backgrounds, code blocks"
    }
  },

  "semantic": {
    "success": {
      "bg":     "#D4EDDA",
      "border": "#C3E6CB",
      "text":   "#155724",
      "icon":   "#28A745",
      "usage":  "Published badge, email verified state, form success messages"
    },
    "warning": {
      "bg":     "#FFF3CD",
      "border": "#FFEEBA",
      "text":   "#856404",
      "icon":   "#FFC107",
      "usage":  "Draft badge, unverified email warning, medium difficulty"
    },
    "error": {
      "bg":     "#F8D7DA",
      "border": "#F5C6CB",
      "text":   "#721C24",
      "icon":   "#DC3545",
      "usage":  "Form validation errors, delete confirmation, API error toasts"
    },
    "info": {
      "bg":     "#D1ECF1",
      "border": "#BEE5EB",
      "text":   "#0C5460",
      "icon":   "#17A2B8",
      "usage":  "Info toasts, hint messages, pagination info"
    }
  },

  "neutral": {
    "50":  "#FAFAFA",
    "100": "#F5F5F5",
    "200": "#E8E2DA",
    "300": "#D4C9B8",
    "400": "#B0A898",
    "500": "#8C8278",
    "600": "#6B6B6B",
    "700": "#4A4A4A",
    "800": "#2C2C2C",
    "900": "#1C1C1C"
  },

  "typography": {
    "fonts": {
      "display": {
        "family": "'Playfair Display', Georgia, serif",
        "import": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&display=swap",
        "tailwind": "font-display",
        "usage": "Page titles (h1), section headings, recipe titles, chef names, logo wordmark"
      },
      "body": {
        "family": "'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif",
        "import": "https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap",
        "tailwind": "font-body",
        "usage": "All body text, labels, buttons, inputs, nav links, descriptions"
      },
      "mono": {
        "family": "'DM Mono', 'Fira Code', 'Courier New', monospace",
        "import": "https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&display=swap",
        "tailwind": "font-mono",
        "usage": "Code snippets, ingredient quantities, time values, stat numbers"
      }
    },
    "scale": {
      "xs":   { "size": "11px", "lineHeight": "1.4", "tailwind": "text-xs" },
      "sm":   { "size": "12px", "lineHeight": "1.5", "tailwind": "text-sm" },
      "base": { "size": "14px", "lineHeight": "1.6", "tailwind": "text-sm" },
      "md":   { "size": "15px", "lineHeight": "1.6", "tailwind": "text-base" },
      "lg":   { "size": "17px", "lineHeight": "1.6", "tailwind": "text-lg" },
      "xl":   { "size": "20px", "lineHeight": "1.4", "tailwind": "text-xl" },
      "2xl":  { "size": "24px", "lineHeight": "1.3", "tailwind": "text-2xl" },
      "3xl":  { "size": "28px", "lineHeight": "1.2", "tailwind": "text-3xl" },
      "4xl":  { "size": "34px", "lineHeight": "1.1", "tailwind": "text-4xl" },
      "5xl":  { "size": "42px", "lineHeight": "1.05","tailwind": "text-5xl" },
      "hero": { "size": "clamp(34px, 6vw, 72px)", "lineHeight": "1.05", "tailwind": "text-5xl lg:text-7xl" }
    },
    "weights": {
      "light":    { "value": 300, "tailwind": "font-light",    "usage": "Subtle captions, meta info" },
      "regular":  { "value": 400, "tailwind": "font-normal",   "usage": "Body text, descriptions, nav links" },
      "medium":   { "value": 500, "tailwind": "font-medium",   "usage": "Labels, button text, card titles" },
      "semibold": { "value": 600, "tailwind": "font-semibold", "usage": "Section headings, form labels, stats" },
      "bold":     { "value": 700, "tailwind": "font-bold",     "usage": "Page titles, recipe names, hero text" },
      "black":    { "value": 900, "tailwind": "font-black",    "usage": "Hero headline, logo text, display headings" }
    }
  },

